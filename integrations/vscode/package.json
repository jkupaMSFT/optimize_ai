{
  "name": "optimize-ai-vscode",
  "displayName": "Optimize AI - Code Compression",
  "description": "Intelligent code compression for AI-powered development. Reduce token usage by 87% while maintaining code quality.",
  "version": "0.1.0",
  "publisher": "optimize-ai",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "compression",
    "gpt",
    "claude",
    "copilot",
    "optimization",
    "python",
    "llm",
    "code-optimizer"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:optimizeai.compress",
    "onCommand:optimizeai.preview",
    "onCommand:optimizeai.showStats",
    "onCommand:optimizeai.copyCompressed",
    "onCommand:optimizeai.toggleAutoCompress",
    "onCommand:optimizeai.clearCache"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "optimizeai.compress",
        "title": "Compress for AI",
        "category": "OptimizeAI"
      },
      {
        "command": "optimizeai.preview",
        "title": "Show Compression Preview",
        "category": "OptimizeAI"
      },
      {
        "command": "optimizeai.showStats",
        "title": "Show Compression Stats",
        "category": "OptimizeAI"
      },
      {
        "command": "optimizeai.copyCompressed",
        "title": "Copy Compressed to Clipboard",
        "category": "OptimizeAI"
      },
      {
        "command": "optimizeai.toggleAutoCompress",
        "title": "Toggle Auto Compression",
        "category": "OptimizeAI"
      },
      {
        "command": "optimizeai.clearCache",
        "title": "Clear Compression Cache",
        "category": "OptimizeAI"
      },
      {
        "command": "optimizeai.runDemo",
        "title": "Run Round-Trip Demo",
        "category": "OptimizeAI"
      }
    ],
    "configuration": {
      "title": "Optimize AI",
      "properties": {
        "optimize-ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Optimize AI extension"
        },
        "optimize-ai.autoCompress": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compress Python files when opened"
        },
        "optimize-ai.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show compression stats in status bar"
        },
        "optimize-ai.compressionThreshold": {
          "type": "number",
          "default": 100,
          "description": "Minimum file size (in tokens) to trigger compression"
        },
        "optimize-ai.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Optimize AI server URL"
        },
        "optimize-ai.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging"
        },
        "optimize-ai.showCompressionNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification messages when compression completes"
        },
        "optimize-ai.maxCacheSize": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of compressed files to keep in cache"
        }
      }
    },
    "statusBarItems": [
      {
        "id": "optimize-ai.statusBar",
        "name": "Optimize AI Status Bar",
        "text": "Optimize AI",
        "alignment": "right",
        "priority": 100
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == python",
          "command": "optimizeai.compress",
          "group": "optimizeai@1"
        },
        {
          "when": "resourceLangId == python",
          "command": "optimizeai.preview",
          "group": "optimizeai@2"
        },
        {
          "when": "resourceLangId == python",
          "command": "optimizeai.showStats",
          "group": "optimizeai@3"
        },
        {
          "when": "resourceLangId == python",
          "command": "optimizeai.copyCompressed",
          "group": "optimizeai@4"
        },
        {
          "when": "resourceLangId == python",
          "command": "optimizeai.toggleAutoCompress",
          "group": "optimizeai@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "./package-extension.sh",
    "package-vsce": "vsce package",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "typescript": "^4.9.5",
    "vsce": "^1.103.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/optimize-ai/optimize-ai.git"
  },
  "bugs": {
    "url": "https://github.com/optimize-ai/optimize-ai/issues"
  },
  "homepage": "https://github.com/optimize-ai/optimize-ai#readme"
}
